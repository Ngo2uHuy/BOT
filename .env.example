TELEGRAM_BOT_TOKEN=
# Telegram user IDs, separated by commas. Use /whoami to find yours.
ALLOWED_TELEGRAM_USER_IDS=123456789
DATA_DIR=./data
# Minimum interval BETWEEN scans of each group, not a guaranteed notification delay.
POLL_INTERVAL_SECONDS=10
HISTORY_INTERVAL_SECONDS=600
HEADLESS=true
SCROLL_PASSES=3
SCAN_WORKERS=4
METRIC_WINDOW_HOURS=24
# api: replay Facebook's own group-feed GraphQL query with the bot session; browser: render pages.
SCAN_MODE=api
# No Chromium or DOM fallback. Requires data/sessions/TELEGRAM_ID.json cookies.
FACEBOOK_BROWSERLESS=true
# Adaptive per-group interval: min after new posts, grows x1.5 up to max when quiet.
SCAN_MIN_INTERVAL_SECONDS=120
SCAN_MAX_INTERVAL_SECONDS=1800
# Per Facebook account GraphQL pacing.
API_MIN_DELAY_MS=3000
API_MAX_DELAY_MS=8000
API_MAX_REQUESTS_PER_HOUR=400
API_CONCURRENCY=1
API_TEMPLATE_TTL_MINUTES=360
# Seconds between reads of the chronological "Most recent" groups feed (one request covers all groups); 0 disables.
FEED_POLL_SECONDS=10
NOTIFICATION_POLL_SECONDS=120

# Optional Shopee Affiliate VN Open API. Leave all three blank to disable.
# Bind this account to ONE authorized Telegram user (/whoami).
# Use Affiliate Open API App ID/Secret, not Shopee seller API credentials.
SHOPEE_AFFILIATE_OWNER_ID=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Optional TikTok Shop Creator Affiliate APIs, Vietnam / VND only.
# Leave ALL blank to disable. Never send credentials through Telegram.
TIKTOK_AFFILIATE_OWNER_ID=
TIKTOK_AFFILIATE_APP_KEY=
TIKTOK_AFFILIATE_APP_SECRET=
TIKTOK_AFFILIATE_ACCESS_TOKEN=
TIKTOK_AFFILIATE_CREATOR_ID=
# Publisher ID assigned in your partner system for Creator Generate Publisher Link.
# This is NOT automatically your Creator ID. Requires Share Link API access.
TIKTOK_AFFILIATE_PUBLISHER_ID=
# Only when your authorized campaign requires it; no auto enrollment in campaigns.
TIKTOK_AFFILIATE_CAMPAIGN_ID=
